//@version=6
indicator("786 Zones", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
// 786 Zones — v5.5
// By: Amir & AHNesari
//
// Draws opening-range zones for trading sessions (Sydney, Tokyo, Hong Kong,
// Frankfurt, London, New York) on the chart.
// ============================================================================

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------

// ── Quick Access ─────────────────────────────────────────────────────────────
grp_qa = "Quick Access"
qaAllMain = input.bool(true,  "Show All Main", group=grp_qa, inline="qa_1")
qaAll14   = input.bool(false, "Show All 14",   group=grp_qa, inline="qa_1")
qaAll18   = input.bool(false, "Show All 18",   group=grp_qa, inline="qa_1")
qaAll30   = input.bool(false, "Show All 30",   group=grp_qa, inline="qa_1")

// کدام سشن‌ها از طریق Quick Access مجاز باشند — این گیت روی هر ۴ نوع زون
// (Main/14/18/30) همان سشن اثر می‌گذارد (نه فقط Main). AND سوم، همراه با
// qaAllZT (سوییچ کلی نوع زون) و تیک خود زون در گروه سشن.
qaSessionSydney    = input.bool(true, "SY", group=grp_qa, inline="qa_main")
qaSessionTokyo     = input.bool(true, "TK", group=grp_qa, inline="qa_main")
qaSessionHongKong  = input.bool(true, "HK", group=grp_qa, inline="qa_main")
qaSessionFrankfurt = input.bool(true, "FR", group=grp_qa, inline="qa_main")
qaSessionLondon    = input.bool(true, "LN", group=grp_qa, inline="qa_main")
qaSessionNewYork   = input.bool(true, "NY", group=grp_qa, inline="qa_main")

// ── General Settings ─────────────────────────────────────────────────────────
grp_gen = "General Settings"
daysBack          = input.int(1, "Days Back", minval=1, maxval=50, group=grp_gen,
     tooltip="1 = today only, 2 = today + yesterday, ...")
showLabels        = input.bool(true,  "Show Labels",   group=grp_gen, inline="gen_1")
labelColor        = input.color(color.white, "",        group=grp_gen, inline="gen_1")
extendMode        = input.string("Fixed", "Extend Mode", options=["Fixed", "End of Day", "End of Chart"], group=grp_gen, inline="gen_2")
zoneExtendMinutes = input.int(240, "Box Width (min)", group=grp_gen, inline="gen_2", minval=5, maxval=1440)
showMidline       = input.bool(false, "Show Midline",  group=grp_gen, inline="gen_3")
midlineColor      = input.color(color.new(color.gray, 40), "", group=grp_gen, inline="gen_3")
midlineStyle      = input.string("Dotted", "", options=["Solid", "Dashed", "Dotted"], group=grp_gen, inline="gen_3")
midlineWidth      = input.int(1, "", minval=1, maxval=4, group=grp_gen, inline="gen_3")

// ── Border ───────────────────────────────────────────────────────────────────
// تنظیمات سراسری بوردر برای تمام باکس‌ها (رنگ بوردر مستقل از رنگ fill سشن است).
// رنگ با همان color picker استاندارد TradingView انتخاب می‌شود که خودش
// opacity/alpha دارد — نیازی به input.int جدا برای شفافیت نیست.
// (نسخه‌ی قبلی یک اینپوت جدای borderOpacity اضافه کرده بود که زائد و
// غیراستاندارد بود؛ اینجا حذف شد و opacity مستقیماً از خودِ رنگ گرفته می‌شود.)
borderColor   = input.color(color.new(color.white, 80), "Border",      group=grp_gen, inline="gen_4")
borderStyle   = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=grp_gen, inline="gen_4")
borderWidth   = input.int(1, "",    minval=1, maxval=4,   group=grp_gen, inline="gen_4")

// ── Sydney ──────────────────────────────────────────────────────────────────
grp_sy = "Sydney"
colSydney     = input.color(color.new(#4169E1, 65), "Color",    group=grp_sy)
showSydney    = input.bool(true,  "Main",    group=grp_sy, inline="sy_1")
showZ14Sydney = input.bool(true,  "14",      group=grp_sy, inline="sy_1")
showZ18Sydney = input.bool(true,  "18",      group=grp_sy, inline="sy_1")
showZ30Sydney = input.bool(true,  "30",      group=grp_sy, inline="sy_1")

// ── Tokyo ───────────────────────────────────────────────────────────────────
grp_tk = "Tokyo"
colTokyo      = input.color(color.new(#3CB371, 65), "Color",    group=grp_tk)
showTokyo     = input.bool(true,  "Main",    group=grp_tk, inline="tk_1")
showZ14Tokyo  = input.bool(true,  "14",      group=grp_tk, inline="tk_1")
showZ18Tokyo  = input.bool(true,  "18",      group=grp_tk, inline="tk_1")
showZ30Tokyo  = input.bool(true,  "30",      group=grp_tk, inline="tk_1")

// ── Hong Kong ───────────────────────────────────────────────────────────────
grp_hk = "Hong Kong"
colHongKong      = input.color(color.new(#DA70D6, 65), "Color",    group=grp_hk)
showHongKong     = input.bool(true,  "Main",    group=grp_hk, inline="hk_1")
showZ14HongKong  = input.bool(true,  "14",      group=grp_hk, inline="hk_1")
showZ18HongKong  = input.bool(true,  "18",      group=grp_hk, inline="hk_1")
showZ30HongKong  = input.bool(true,  "30",      group=grp_hk, inline="hk_1")

// ── Frankfurt ───────────────────────────────────────────────────────────────
grp_fr = "Frankfurt"
colFrankfurt      = input.color(color.new(#FFA500, 65), "Color",    group=grp_fr)
showFrankfurt     = input.bool(true,  "Main",    group=grp_fr, inline="fr_1")
showZ14Frankfurt  = input.bool(true,  "14",      group=grp_fr, inline="fr_1")
showZ18Frankfurt  = input.bool(true,  "18",      group=grp_fr, inline="fr_1")
showZ30Frankfurt  = input.bool(true,  "30",      group=grp_fr, inline="fr_1")

// ── London ──────────────────────────────────────────────────────────────────
grp_ln = "London"
colLondon      = input.color(color.new(#DC143C, 65), "Color",    group=grp_ln)
showLondon     = input.bool(true,  "Main",    group=grp_ln, inline="ln_1")
showZ14London  = input.bool(true,  "14",      group=grp_ln, inline="ln_1")
showZ18London  = input.bool(true,  "18",      group=grp_ln, inline="ln_1")
showZ30London  = input.bool(true,  "30",      group=grp_ln, inline="ln_1")

// ── New York ─────────────────────────────────────────────────────────────────
grp_ny = "New York"
colNewYork      = input.color(color.new(#FFD700, 65), "Color",    group=grp_ny)
showNewYork     = input.bool(true,  "Main",    group=grp_ny, inline="ny_1")
showZ14NewYork  = input.bool(true,  "14",      group=grp_ny, inline="ny_1")
showZ18NewYork  = input.bool(true,  "18",      group=grp_ny, inline="ny_1")
showZ30NewYork  = input.bool(true,  "30",      group=grp_ny, inline="ny_1")

// ── Early Zone (زمان تغییرپذیر زون اصلی) ─────────────────────────────────────
grp_early = "Early Zone (زمان‌های خاص)"
useEarlyMain    = input.bool(false, "Enable Early Main (9:00 → 8:50)", group=grp_early, tooltip="وقتی روشن باشد، زون اصلی (Main) برای همه سشن‌ها به‌جای ۹:۰۰ از ۸:۵۰ محاسبه می‌شود.")
earlyAffects14  = input.bool(false, "Apply to Zone 14 too (14:00 → 13:50)", group=grp_early, inline="early_1")
earlyAffects18  = input.bool(false, "Apply to Zone 18 too",                 group=grp_early, inline="early_1")
earlyAffects30  = input.bool(false, "Apply to Zone 30 too",                 group=grp_early, inline="early_1")

// ── Moving Average 1 ─────────────────────────────────────────────────────────
grp_ma1 = "Moving Average 1"
ma1Enable = input.bool(false, "Enable", group=grp_ma1, inline="ma1_1")
ma1Type   = input.string("EMA", "Type", options=["SMA", "EMA"], group=grp_ma1, inline="ma1_1")
ma1Length = input.int(21, "Length", minval=1, group=grp_ma1, inline="ma1_2")
ma1Source = input.source(close, "Source", group=grp_ma1, inline="ma1_2")
ma1Color  = input.color(color.new(#2196F3, 0), "Color", group=grp_ma1, inline="ma1_3")
ma1Style  = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=grp_ma1, inline="ma1_3")
ma1Width  = input.int(1, "", minval=1, maxval=4, group=grp_ma1, inline="ma1_3")

// ── Moving Average 2 ─────────────────────────────────────────────────────────
grp_ma2 = "Moving Average 2"
ma2Enable = input.bool(false, "Enable", group=grp_ma2, inline="ma2_1")
ma2Type   = input.string("EMA", "Type", options=["SMA", "EMA"], group=grp_ma2, inline="ma2_1")
ma2Length = input.int(21, "Length", minval=1, group=grp_ma2, inline="ma2_2")
ma2Source = input.source(close, "Source", group=grp_ma2, inline="ma2_2")
ma2Color  = input.color(color.new(#FF5252, 0), "Color", group=grp_ma2, inline="ma2_3")
ma2Style  = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=grp_ma2, inline="ma2_3")
ma2Width  = input.int(1, "", minval=1, maxval=4, group=grp_ma2, inline="ma2_3")



// ---------------------------------------------------------------------------
// Early Zone — مقدار ثابت offset (به دقیقه) برای حالت "زمان تغییرپذیر"
// وقتی useEarlyMain روشن باشد، ساعت محلی زون اصلی (و در صورت فعال بودن
// سوییچ مربوطه، زون ۱۴) به‌جای baseHour دقیق، EARLY_OFFSET_MIN دقیقه زودتر
// محاسبه می‌شود (مثلاً ۹:۰۰ → ۸:۵۰). این مقدار عمداً ثابت در کد است طبق
// درخواست کاربر (فقط دولوپر می‌تواند تغییرش دهد).
// ---------------------------------------------------------------------------
EARLY_OFFSET_MIN = 10

// ---------------------------------------------------------------------------
// DST توابع — منطق دقیقاً از نسخه‌ی MQL5 گرفته‌شده
// ---------------------------------------------------------------------------
sundayOfMonth(int yr, int mo, int week) =>
    firstDay = timestamp("GMT", yr, mo, 1, 0, 0)
    dow = dayofweek(firstDay, "GMT")
    daysToFirstSun = dow == 1 ? 0 : (8 - dow)
    firstSunDay = 1 + daysToFirstSun
    result = 0
    if week == -1
        d = firstSunDay + 21
        while d + 7 <= (mo == 2 ? (yr % 4 == 0 and (yr % 100 != 0 or yr % 400 == 0) ? 29 : 28) :
                        (mo == 4 or mo == 6 or mo == 9 or mo == 11 ? 30 :
                         mo == 1 or mo == 3 or mo == 5 or mo == 7 or mo == 8 or mo == 10 or mo == 12 ? 31 : 30))
            d := d + 7
        result := d
    else
        result := firstSunDay + (week - 1) * 7
    result

isUSA_DST(int y, int mo, int d) =>
    bool res = false
    if mo < 3 or mo > 11
        res := false
    else if mo > 3 and mo < 11
        res := true
    else
        secondSun  = sundayOfMonth(y, 3, 2)
        firstSunNov = sundayOfMonth(y, 11, 1)
        if mo == 3
            res := d >= secondSun
        else if mo == 11
            res := d < firstSunNov
    res

isEurope_DST(int y, int mo, int d) =>
    bool res = false
    if mo < 3 or mo > 10
        res := false
    else if mo > 3 and mo < 10
        res := true
    else
        lastSunMar = sundayOfMonth(y, 3, -1)
        lastSunOct = sundayOfMonth(y, 10, -1)
        if mo == 3
            res := d >= lastSunMar
        else if mo == 10
            res := d < lastSunOct
    res

isAustralia_DST(int y, int mo, int d) =>
    bool res = false
    if mo > 4 and mo < 10
        res := false
    else if mo > 10 or mo < 4
        res := true
    else
        firstSunOct = sundayOfMonth(y, 10, 1)
        firstSunApr = sundayOfMonth(y, 4, 1)
        if mo == 10
            res := d >= firstSunOct
        else if mo == 4
            res := d < firstSunApr
    res

// ---------------------------------------------------------------------------
// آفست UTC (به ساعت) هر سشن با درنظرگرفتن DST
// idx: 0=Sydney 1=Tokyo 2=HongKong 3=Frankfurt 4=London 5=NewYork
// ---------------------------------------------------------------------------
sessionUTCOffsetHours(int idx, int y, int mo, int d) =>
    float res = 0
    if idx == 0
        res := isAustralia_DST(y, mo, d) ? 11 : 10
    else if idx == 1
        res := 9
    else if idx == 2
        res := 8
    else if idx == 3
        res := isEurope_DST(y, mo, d) ? 2 : 1
    else if idx == 4
        res := isEurope_DST(y, mo, d) ? 1 : 0
    else if idx == 5
        res := isUSA_DST(y, mo, d) ? -4 : -5
    res

// دقیقه‌ی GMT از نیمه‌شب روز y/mo/d که ساعت محلی سشن idx برابر baseHour شود
zoneGMTMinutes(int baseHour, int idx, int y, int mo, int d) =>
    offset = sessionUTCOffsetHours(idx, y, mo, d)
    gh = baseHour - offset
    if gh < 0
        gh := gh + 24
    if gh >= 24
        gh := gh - 24
    int(gh * 60)

// ---------------------------------------------------------------------------
// timestamp دقیق شروع سشن idx (برای ساعت محلی baseHour) برای "امروز منهای
// db روز" (بر اساس GMT). این تابع برای هر نوع زون (ساعت ۹ اصلی، ساعت ۱۴، یا
// هر ساعت دیگری در آینده) با baseHour متفاوت به‌کار می‌رود.
//
// نکته‌ی Sydney: چون بعضی ساعت‌های محلی (مثل ۹ صبح) به‌خاطر آفست بزرگ سیدنی
// (+۱۰/+۱۱) می‌توانند به روز GMT قبل سرریز کنند، یک روز به refDay اضافه
// می‌کنیم تا db=0 معنی "سیدنی امشب/دیشب" بدهد، و سپس rollover طبیعی
// (targetMin >= 20*60) آن را به شب درست برمی‌گرداند. طبق مستندات نسخه‌ی
// اصلی MQL5، این قانون rollover عمومی و بدون قید-و-شرط پیاده شده - خودش بر
// اساس مقدار محاسبه‌شده تشخیص می‌دهد که آیا لازم است، پس با هر baseHour
// (۹، ۱۴، یا هر عدد دیگر) به‌درستی کار می‌کند.
// ---------------------------------------------------------------------------
// minuteOffsetMs: مقدار میلی‌ثانیه‌ای که پس از محاسبه‌ی کامل زمان هدف (شامل
// DST و rollover سیدنی) از نتیجه کم می‌شود. برای حالت عادی همیشه 0 پاس داده
// می‌شود. برای "Early Zone" مقدار EARLY_OFFSET_MIN * 60000 پاس داده می‌شود تا
// مثلاً ۹:۰۰ به ۸:۵۰ تبدیل شود — بدون دست‌زدن به منطق DST/rollover که در بالا
// محاسبه شده (چون offset بعد از تمام‌شدن کار rollover اعمال می‌شود، هیچ باگ
// جدیدی در مرز نیمه‌شب یا rollover سیدنی ایجاد نمی‌شود).
sessionZoneStart(int idx, int db, int chartTime, int baseHour, int minuteOffsetMs) =>
    todayMidnightGMT = timestamp("GMT", year(chartTime, "GMT"), month(chartTime, "GMT"), dayofmonth(chartTime, "GMT"), 0, 0)

    refDayMs = todayMidnightGMT - db * 86400000

    refY  = year(refDayMs, "GMT")
    refMo = month(refDayMs, "GMT")
    refD  = dayofmonth(refDayMs, "GMT")

    targetMin   = zoneGMTMinutes(baseHour, idx, refY, refMo, refD)
    targetStart = timestamp("GMT", refY, refMo, refD, 0, 0) + targetMin * 60000

    // رول‌اور سیدنی: وقتی GMT>=20:00 باشد به روز GMT قبل تعلق دارد (عمومی، مستقل از baseHour)
    if idx == 0 and targetMin >= 20 * 60
        targetStart := targetStart - 86400000

    targetStart - minuteOffsetMs

// ---------------------------------------------------------------------------
// ساختار نگهداری داده‌های زون‌ها
// slot = zt*60 + i*10 + db  (zt: نوع زون [0=اصلی,1=زون۱۴,2=زون۱۸,3=زون۳۰] | i: سشن [0-5] | db: روز گذشته [0-9])
// یعنی حداکثر 4 نوع زون × 6 سشن × 10 روز = 240 خانه.
// ---------------------------------------------------------------------------
var string[] sessionNames = array.from("SY", "TK", "HK", "FR", "LN", "NY")

TOTAL_SLOTS = 4 * 6 * 10

var box[]   zoneBoxes   = array.new<box>(TOTAL_SLOTS)
var line[]  zoneMids    = array.new<line>(TOTAL_SLOTS)
var label[] zoneLabels  = array.new<label>(TOTAL_SLOTS)
var float[] zoneHigh    = array.new<float>(TOTAL_SLOTS, na)
var float[] zoneLow     = array.new<float>(TOTAL_SLOTS, na)
var int[]   zoneStartMs = array.new<int>(TOTAL_SLOTS, 0)
var bool[]  zoneFormed  = array.new<bool>(TOTAL_SLOTS, false)

// آیا سوییچ Quick Access مخصوص سشن idx روشن است؟ (روی هر ۴ نوع زون اثر دارد)
f_qaSession(int idx) =>
    idx == 0 ? qaSessionSydney : idx == 1 ? qaSessionTokyo : idx == 2 ? qaSessionHongKong :
     idx == 3 ? qaSessionFrankfurt : idx == 4 ? qaSessionLondon : qaSessionNewYork

f_show(int idx) =>
    idx == 0 ? showSydney : idx == 1 ? showTokyo : idx == 2 ? showHongKong :
     idx == 3 ? showFrankfurt : idx == 4 ? showLondon : showNewYork

f_color(int idx) =>
    idx == 0 ? colSydney : idx == 1 ? colTokyo : idx == 2 ? colHongKong :
     idx == 3 ? colFrankfurt : idx == 4 ? colLondon : colNewYork

// آیا زون idx از نوع zt باید نمایش داده شود؟
// همه‌ی انواع (Main/14/18/30) از یک ساختار یکسان AND پیروی می‌کنند:
//   qaAllZT (سوییچ کلی نوع زون) AND f_qaSession(idx) (گیت سبز، مشترک برای هر
//   ۴ نوع زون همان سشن) AND perSessionSwitch(zt, idx) (تیک خود زون در گروه سشن)
f_showZT(int zt, int idx) =>
    if zt == 0
        qaAllMain and f_qaSession(idx) and f_show(idx)
    else if zt == 1
        perSessionOn = idx == 0 ? showZ14Sydney : idx == 1 ? showZ14Tokyo : idx == 2 ? showZ14HongKong :
             idx == 3 ? showZ14Frankfurt : idx == 4 ? showZ14London : showZ14NewYork
        qaAll14 and f_qaSession(idx) and perSessionOn
    else if zt == 2
        perSessionOn = idx == 0 ? showZ18Sydney : idx == 1 ? showZ18Tokyo : idx == 2 ? showZ18HongKong :
             idx == 3 ? showZ18Frankfurt : idx == 4 ? showZ18London : showZ18NewYork
        qaAll18 and f_qaSession(idx) and perSessionOn
    else
        perSessionOn = idx == 0 ? showZ30Sydney : idx == 1 ? showZ30Tokyo : idx == 2 ? showZ30HongKong :
             idx == 3 ? showZ30Frankfurt : idx == 4 ? showZ30London : showZ30NewYork
        qaAll30 and f_qaSession(idx) and perSessionOn

// ساعت محلی مبنای هر نوع زون (zt=2 offset-based است، این مقدار در حلقه‌ی تشخیص استفاده نمی‌شود)
f_baseHour(int zt) => zt == 0 ? 9 : 14

// ---------------------------------------------------------------------------
// Early Zone — مقدار offset (به میلی‌ثانیه) برای zt=0 و zt=1 در sessionZoneStart
// zt=0: اگر useEarlyMain روشن باشد، همیشه EARLY_OFFSET_MIN اعمال می‌شود
//       (سوییچ سراسری، مستقل از سشن).
// zt=1: فقط اگر useEarlyMain و earlyAffects14 هر دو روشن باشند اعمال می‌شود.
// ---------------------------------------------------------------------------
f_earlyOffsetMs(int zt) =>
    ms = 0
    if zt == 0 and useEarlyMain
        ms := EARLY_OFFSET_MIN * 60000
    else if zt == 1 and useEarlyMain and earlyAffects14
        ms := EARLY_OFFSET_MIN * 60000
    ms

// پسوند برچسب برای تفکیک بصری نوع زون روی چارت
f_ztSuffix(int zt) => zt == 0 ? "" : zt == 1 ? "14" : zt == 2 ? "18" : "30"

// ---------------------------------------------------------------------------
// داده‌های M1 — همیشه از security_lower_tf("1") استفاده می‌کنیم.
// این call روی M1 و تمام تایم‌فریم‌های بالاتر معتبر است (M1 پایین‌ترین TF
// استاندارد TradingView است). هیچ شرط تایم‌فریمی لازم نیست.
//
// هر بار چارت یک آرایه از تمام کندل‌های M1 داخل آن بار را برمی‌گرداند.
// روی M1 خود چارت، آرایه دقیقاً یک عنصر دارد.
// ---------------------------------------------------------------------------
m1TimeArr = request.security_lower_tf(syminfo.tickerid, "1", time)
m1HighArr = request.security_lower_tf(syminfo.tickerid, "1", high)
m1LowArr  = request.security_lower_tf(syminfo.tickerid, "1", low)

// ---------------------------------------------------------------------------
// رفع باگ daysBack: "امروز" باید یک مرجع ثابت (نزدیک‌ترین لحظه‌ی واقعی) باشد.
// از last_bar_time استفاده می‌کنیم (زمان آخرین کندل موجود در نماد، مستقل از
// اینکه چارت خودمان چه تایم‌فریمی دارد) تا targetStart هر (سشن×روز) ثابت
// بماند و هر کندل تاریخی "امروز" را نسبت به خودش دوباره حساب نکند.
// ---------------------------------------------------------------------------
nowRef = timenow

// ---------------------------------------------------------------------------
// منطق تشخیص زون‌ها با مرجع M1
//
// zt=0 و zt=1: پنجره = [targetStart, targetStart + 300000ms) — 5 کندل M1
//   targetStart از sessionZoneStart (بر اساس ساعت محلی + DST) محاسبه می‌شود.
//
// zt=2 (زون ۱۸): پنجره = [zoneStartMs[zt=0] + 40*60000, zoneStartMs[zt=0] + 44*60000)
//   یعنی کندل‌های M1 از دقیقه‌ی ۴۰ تا ۴۴ بعد از شروع زون اصلی همان سشن/روز.
//   zt=2 فقط وقتی zoneFormed[zt=0] برای همان سشن/روز true باشد پردازش می‌شود.
// ---------------------------------------------------------------------------
if array.size(m1TimeArr) > 0
    for k = 0 to array.size(m1TimeArr) - 1
        mt = array.get(m1TimeArr, k)
        mh = array.get(m1HighArr, k)
        ml = array.get(m1LowArr,  k)

        // zt=0 و zt=1: منطق hour-based (sessionZoneStart)
        for zt = 0 to 1
            for i = 0 to 5
                if f_showZT(zt, i)
                    for db = 0 to daysBack - 1
                        targetStart = sessionZoneStart(i, db, nowRef, f_baseHour(zt), f_earlyOffsetMs(zt))
                        // پنجره: 5 دقیقه از شروع سشن = 5 کندل M1
                        if mt >= targetStart and mt < targetStart + 300000
                            slot     = zt * 60 + i * 10 + db
                            curStart = array.get(zoneStartMs, slot)

                            if curStart != targetStart
                                // شروع سشن جدید: مقداردهی اولیه
                                array.set(zoneStartMs, slot, targetStart)
                                array.set(zoneHigh,    slot, mh)
                                array.set(zoneLow,     slot, ml)
                                array.set(zoneFormed,  slot, true)
                            else
                                // ادامه‌ی همان سشن: به‌روزرسانی High/Low ترکیبی
                                prevHigh = array.get(zoneHigh, slot)
                                prevLow  = array.get(zoneLow,  slot)
                                if not na(prevHigh) and mh > prevHigh
                                    array.set(zoneHigh, slot, mh)
                                if not na(prevLow) and ml < prevLow
                                    array.set(zoneLow, slot, ml)

        // zt=2 (Zone 18): offset-based
        // اگر earlyAffects18 روشن باشد: مبنا = zoneStartMs[zt=0] واقعی (که خودش
        //   ممکن است تحت تأثیر useEarlyMain باشد؛ به‌طور خودکار وابسته می‌شود) و
        //   وابستگی به zoneFormed[zt=0] (یعنی f_showZT(0,i)) حفظ می‌شود، چون
        //   منبع مقدار واقعی همان زون اصلی نمایش‌داده‌شده است.
        // اگر earlyAffects18 خاموش باشد: مبنا مستقل و ثابت روی ساعت ۹:۰۰
        //   محلی محاسبه می‌شود (سوییچ Early اصلاً روی آن اثر ندارد)، و کاملاً
        //   مستقل از این‌که زون اصلی (zt=0) نمایش داده می‌شود یا نه رسم می‌شود.
        for i = 0 to 5
            if f_showZT(2, i)
                for db = 0 to daysBack - 1
                    slot0 = 0 * 60 + i * 10 + db
                    int baseStart = 0
                    bool haveBase = false
                    if earlyAffects18
                        if array.get(zoneFormed, slot0)
                            baseStart := array.get(zoneStartMs, slot0)
                            haveBase  := true
                    else
                        baseStart := sessionZoneStart(i, db, nowRef, 9, 0)
                        haveBase  := true
                    if haveBase
                        windowStart = baseStart + 40 * 60000
                        windowEnd   = baseStart + 45 * 60000
                        if mt >= windowStart and mt < windowEnd
                            slot18   = 2 * 60 + i * 10 + db
                            curStart = array.get(zoneStartMs, slot18)
                            if curStart != windowStart
                                array.set(zoneStartMs, slot18, windowStart)
                                array.set(zoneHigh,    slot18, mh)
                                array.set(zoneLow,     slot18, ml)
                                array.set(zoneFormed,  slot18, true)
                            else
                                prevHigh = array.get(zoneHigh, slot18)
                                prevLow  = array.get(zoneLow,  slot18)
                                if not na(prevHigh) and mh > prevHigh
                                    array.set(zoneHigh, slot18, mh)
                                if not na(prevLow) and ml < prevLow
                                    array.set(zoneLow, slot18, ml)

        // zt=3 (Zone 30): offset-based — همان منطق zt=2 با سوییچ earlyAffects30
        for i = 0 to 5
            if f_showZT(3, i)
                for db = 0 to daysBack - 1
                    slot0 = 0 * 60 + i * 10 + db
                    int baseStart = 0
                    bool haveBase = false
                    if earlyAffects30
                        if array.get(zoneFormed, slot0)
                            baseStart := array.get(zoneStartMs, slot0)
                            haveBase  := true
                    else
                        baseStart := sessionZoneStart(i, db, nowRef, 9, 0)
                        haveBase  := true
                    if haveBase
                        windowStart = baseStart + 190 * 60000
                        windowEnd   = baseStart + 195 * 60000
                        if mt >= windowStart and mt < windowEnd
                            slot30   = 3 * 60 + i * 10 + db
                            curStart = array.get(zoneStartMs, slot30)
                            if curStart != windowStart
                                array.set(zoneStartMs, slot30, windowStart)
                                array.set(zoneHigh,    slot30, mh)
                                array.set(zoneLow,     slot30, ml)
                                array.set(zoneFormed,  slot30, true)
                            else
                                prevHigh = array.get(zoneHigh, slot30)
                                prevLow  = array.get(zoneLow,  slot30)
                                if not na(prevHigh) and mh > prevHigh
                                    array.set(zoneHigh, slot30, mh)
                                if not na(prevLow) and ml < prevLow
                                    array.set(zoneLow, slot30, ml)

// ---------------------------------------------------------------------------
// رسم/بروزرسانی باکس‌ها روی آخرین بار
// ---------------------------------------------------------------------------
if barstate.islast
    for zt = 0 to 3
        for i = 0 to 5
            if f_showZT(zt, i)
                for db = 0 to daysBack - 1
                    slot = zt * 60 + i * 10 + db
                    if array.get(zoneFormed, slot)
                        zHigh  = array.get(zoneHigh,    slot)
                        zLow   = array.get(zoneLow,     slot)
                        zStart = array.get(zoneStartMs, slot)

                        // محاسبه زمان پایان باکس بر اساس Extend Mode
                        zEnd = if extendMode == "End of Chart"
                            time_close
                        else if extendMode == "End of Day"
                            // آخر روز معاملاتی = 21:00 GMT همان روز تجاری
                            // اگر zStart بعد از 21:00 GMT باشد (مثل سیدنی که rollover دارد)،
                            // 21:00 GMT روز بعد را می‌گیریم تا به روز تجاری درست برسیم
                            zHourGMT = hour(zStart, "GMT") * 60 + minute(zStart, "GMT")
                            zRefMs   = zHourGMT >= 21 * 60 ? zStart + 86400000 : zStart
                            zYear    = year(zRefMs, "GMT")
                            zMonth   = month(zRefMs, "GMT")
                            zDay     = dayofmonth(zRefMs, "GMT")
                            timestamp("GMT", zYear, zMonth, zDay, 21, 0, 0)
                        else
                            zStart + zoneExtendMinutes * 60000

                        dispColor = f_color(i)

                        // باکس — borderColor مستقیماً از color picker استاندارد می‌آید
                        // و خودش alpha/opacity دارد، نیازی به ترکیب دستی نیست.
                        bdrStyle = borderStyle == "Solid" ? line.style_solid : borderStyle == "Dashed" ? line.style_dashed : line.style_dotted
                        existingBox = array.get(zoneBoxes, slot)
                        if na(existingBox)
                            newBox = box.new(left=zStart, top=zHigh, right=zEnd, bottom=zLow,
                                 xloc=xloc.bar_time, border_color=borderColor, bgcolor=dispColor,
                                 border_width=borderWidth, border_style=bdrStyle)
                            array.set(zoneBoxes, slot, newBox)
                        else
                            box.set_lefttop(existingBox,     zStart, zHigh)
                            box.set_rightbottom(existingBox, zEnd,   zLow)
                            box.set_bgcolor(existingBox,        dispColor)
                            box.set_border_color(existingBox,   borderColor)
                            box.set_border_width(existingBox,   borderWidth)
                            box.set_border_style(existingBox,   bdrStyle)

                        // خط وسط
                        if showMidline
                            midY = (zHigh + zLow) / 2.0
                            midStyle = midlineStyle == "Solid" ? line.style_solid : midlineStyle == "Dashed" ? line.style_dashed : line.style_dotted
                            existingMid = array.get(zoneMids, slot)
                            if na(existingMid)
                                newMid = line.new(zStart, midY, zEnd, midY, xloc=xloc.bar_time,
                                     color=midlineColor, style=midStyle, width=midlineWidth)
                                array.set(zoneMids, slot, newMid)
                            else
                                line.set_xy1(existingMid, zStart, midY)
                                line.set_xy2(existingMid, zEnd,   midY)
                                line.set_color(existingMid, midlineColor)
                                line.set_style(existingMid, midStyle)
                                line.set_width(existingMid, midlineWidth)
                        else
                            existingMid2 = array.get(zoneMids, slot)
                            if not na(existingMid2)
                                line.delete(existingMid2)
                                array.set(zoneMids, slot, na)

                        // برچسب نام سشن
                        if showLabels
                            labelSuffix = f_ztSuffix(zt) + (db == 0 ? "" : " (-" + str.tostring(db) + "d)")
                            existingLbl = array.get(zoneLabels, slot)
                            if na(existingLbl)
                                newLbl = label.new(zStart, zHigh, array.get(sessionNames, i) + labelSuffix,
                                     xloc=xloc.bar_time, style=label.style_label_down,
                                     color=color.new(color.black, 100), textcolor=labelColor, size=size.small)
                                array.set(zoneLabels, slot, newLbl)
                            else
                                label.set_xy(existingLbl,    zStart, zHigh)
                                label.set_text(existingLbl,  array.get(sessionNames, i) + labelSuffix)
                                label.set_textcolor(existingLbl, labelColor)
                        else
                            existingLbl2 = array.get(zoneLabels, slot)
                            if not na(existingLbl2)
                                label.delete(existingLbl2)
                                array.set(zoneLabels, slot, na)

// ---------------------------------------------------------------------------
// Moving Averages — از plot() استفاده می‌شود چون MA یک سری زمانی پیوسته است.
// نکته‌ی فنی مهم: پارامتر linestyle باید یک ثابت input-qualified باشد، نه
// نتیجه‌ی یک تابع/سری در زمان اجرا (Pine Script error CE10123). به همین دلیل
// نمی‌توان از یک تابع کمکی که رشته را به plot.linestyle_* تبدیل کند استفاده
// کرد؛ باید هر حالت را با plot() جداگانه (و شرط ساده روی خود ورودی رشته‌ای)
// صدا زد تا کامپایلر بتواند linestyle را در زمان کامپایل تشخیص دهد.
// ---------------------------------------------------------------------------
ma1Val = ma1Type == "SMA" ? ta.sma(ma1Source, ma1Length) : ta.ema(ma1Source, ma1Length)
ma2Val = ma2Type == "SMA" ? ta.sma(ma2Source, ma2Length) : ta.ema(ma2Source, ma2Length)

ma1Plot = ma1Enable ? ma1Val : na
ma2Plot = ma2Enable ? ma2Val : na

plot(ma1Style == "Solid" ? ma1Plot : na,  title="MA 1 (Solid)",  color=ma1Color, linewidth=ma1Width, linestyle=plot.linestyle_solid)
plot(ma1Style == "Dashed" ? ma1Plot : na, title="MA 1 (Dashed)", color=ma1Color, linewidth=ma1Width, linestyle=plot.linestyle_dashed)
plot(ma1Style == "Dotted" ? ma1Plot : na, title="MA 1 (Dotted)", color=ma1Color, linewidth=ma1Width, linestyle=plot.linestyle_dotted)

plot(ma2Style == "Solid" ? ma2Plot : na,  title="MA 2 (Solid)",  color=ma2Color, linewidth=ma2Width, linestyle=plot.linestyle_solid)
plot(ma2Style == "Dashed" ? ma2Plot : na, title="MA 2 (Dashed)", color=ma2Color, linewidth=ma2Width, linestyle=plot.linestyle_dashed)
plot(ma2Style == "Dotted" ? ma2Plot : na, title="MA 2 (Dotted)", color=ma2Color, linewidth=ma2Width, linestyle=plot.linestyle_dotted)
