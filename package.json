{
  "name": "mt5-chart-terminal",
  "version": "1.9.218",
  "description": "OJchart — TradingView-style chart terminal powered by MetaTrader 5 data",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "verify": "npm run check:syntax && npm run check:imports && npm run check:py && npm run check:electron && npm run test:unit && npm run check:mt5 && npm run smoke",
    "check:syntax": "node scripts/checks/check-syntax.mjs",
    "check:imports": "node scripts/checks/check-imports.mjs",
    "check:py": "node scripts/checks/check-python.mjs",
    "check:electron": "node scripts/checks/check-electron.mjs",
    "test:unit": "node scripts/checks/run-unit.mjs",
    "check:mt5": "node scripts/checks/check-mt5.mjs",
    "report:core-coverage": "node scripts/checks/core-coverage.mjs",
    "report:perf": "node scripts/checks/perf-profile.mjs",
    "check:pine-budget": "node tests/unit/test_round281_corpus_budget.mjs",
    "check:e2e": "node scripts/checks/e2e-gate.mjs",
    "smoke": "node scripts/checks/smoke-boot.mjs",
    "test": "npm run verify",
    "release": "node scripts/release.mjs"
  },
  "author": "AHNesari",
  "license": "MIT",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ojchart.terminal",
    "productName": "OJchart",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "provider/**/*",
      "!provider/__pycache__/**",
      "assets/**/*",
      "!scripts/**",
      "!tests/**",
      "!tools/**",
      "!fixtures/**",
      "!docs/**"
    ],
    "asarUnpack": [
      "provider/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon-1024.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon-1024.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nesari",
        "repo": "oj-chart-terminal",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
