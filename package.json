{
  "name": "mt5-chart-terminal",
  "version": "1.9.212",
  "description": "TradingView-style chart terminal powered by MetaTrader 5 data",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "verify": "npm run check:syntax && npm run check:imports && npm run check:py && npm run smoke",
    "check:syntax": "node scripts/checks/check-syntax.mjs",
    "check:imports": "node scripts/checks/check-imports.mjs",
    "check:py": "node scripts/checks/check-python.mjs",
    "smoke": "node scripts/checks/smoke-boot.mjs",
    "test": "npm run verify",
    "release": "node scripts/release.mjs"
  },
  "author": "Farzad",
  "license": "MIT",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ojchart.terminal",
    "productName": "OJ Chart Terminal",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "provider/**/*",
      "!provider/__pycache__/**",
      "assets/**/*",
      "!scripts/**",
      "!tests/**",
      "!tools/**",
      "!fixtures/**",
      "!docs/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon-1024.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon-1024.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
