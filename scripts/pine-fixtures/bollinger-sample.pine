//@version=6
indicator("Bollinger (sample)", overlay=true)
length = input.int(20, "Length", minval=1)
mult = input.float(2.0, "StdDev", minval=0.1, maxval=10)
basis = ta.sma(close, length)
dev = mult * ta.stdev(close, length)
upper = basis + dev
lower = basis - dev
pU = plot(upper, title="Upper", color=color.new(color.blue, 0))
pL = plot(lower, title="Lower", color=color.new(color.blue, 0))
fill(pU, pL, color=color.new(color.blue, 92))
plot(basis, title="Basis", color=color.new(color.orange, 0), linewidth=2)
plotshape(ta.crossover(close, upper), title="Break Up", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
